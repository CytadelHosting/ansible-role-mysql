{#-
  Macros shared by the templates of templates/mariadb_includes/<version>/*.

  Principle: these templates are the include files shipped by the official
  MariaDB package, where every commented option can be driven by a variable.
    - variable NOT set by the project -> the line is rendered exactly as in
      the package (still commented, package default value).
    - variable set by the project (host_vars, group_vars, -e) -> the line is
      uncommented and carries the value of the variable.

  "Set by the project" cannot be tested with `is defined`: the role defaults
  define almost every mysql_* variable. The role records the variables that
  come from the inventory in mysql_explicit_vars (see tasks/explicit-vars.yml).

  Whitespace: macros are called through {{ }} expressions, which are not
  affected by trim_blocks, so the line layout of the package file is kept.
-#}

{#- opt: "key = value" option.
      var      variable that drives the option, or a list of variables: the first one set wins
               (general_log_file: mysql_general_log_file, then the legacy mysql_log)
      prefix   text before the value, exactly as in the package file (key, padding, "= ")
      default  package default, shown when the line stays commented
      quote    '"' when the value must be quoted
      comment  full commented line when it differs from "#" + prefix + default
      value    rendered instead of the variable value (e.g. 1 for general_log)
      unless   value for which the option stays commented (e.g. 'syslog')
      active   prefix written INSTEAD of `prefix` when the line is active (variable set). The commented line
               keeps the package spelling; the active one can use a name every 10.x server accepts
               (log_slow_query_file is unknown before 10.11, slow_query_log_file works everywhere)
-#}
{% macro opt(var, prefix, default, quote='', comment='', value=none, unless=none, active='') -%}
{%- set found = namespace(current=none) -%}
{%- for name in ([var] if var is string else var) -%}
{%- if found.current in [none, ''] and name in mysql_explicit_vars -%}
{%- set found.current = lookup('ansible.builtin.vars', name) -%}
{%- endif -%}
{%- endfor -%}
{%- set current = found.current -%}
{%- if current not in [none, ''] and current != unless -%}
{{ active if active else prefix }}{{ quote }}{{ current if value is none else value }}{{ quote }}
{%- else -%}
{{ comment if comment else '#' ~ prefix ~ quote ~ default ~ quote }}
{%- endif -%}
{%- endmacro %}

{#- act: ACTIVE option of the package ("bind-address = 127.0.0.1").
      The package value stays when the project does not set the variable; otherwise the value of the variable.
      Unlike opt, the line is never commented. -#}
{% macro act(var, prefix, default) -%}
{%- set current = lookup('ansible.builtin.vars', var) if var in mysql_explicit_vars else none -%}
{{ prefix }}{{ default if current in [none, ''] else current }}
{%- endmacro %}

{#- rows: the "option = value" lines of the role-owned includes (70-, 80-), only for the variables
      the project sets (mysql_explicit_vars). Nothing is written for the others.
      options  list of (variable, option[, kind])
      kind     (none)  the value as is
               onoff   ON / OFF from a boolean
               flag    option without value (skip-log-bin), written when the variable is true
               quote   value between single quotes
      A list value repeats the option (ignore_db_dirs, performance-schema-instrument). -#}
{% macro rows(options) -%}
{%- set out = namespace(lines=[]) -%}
{%- for item in options -%}
{%- if item[0] in mysql_explicit_vars and lookup('ansible.builtin.vars', item[0]) not in [none, ''] -%}
{%- set raw = lookup('ansible.builtin.vars', item[0]) -%}
{%- set kind = item[2] | default('') -%}
{%- if kind == 'flag' -%}
{%- if raw | bool -%}{%- set out.lines = out.lines + [item[1]] -%}{%- endif -%}
{%- else -%}
{%- for value in (raw if (raw is iterable and raw is not string and raw is not mapping) else [raw]) -%}
{%- set shown = ('ON' if value | bool else 'OFF') if kind == 'onoff' else (("'" ~ value ~ "'") if kind == 'quote' else value) -%}
{%- set out.lines = out.lines + [item[1] ~ ' = ' ~ shown] -%}
{%- endfor -%}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{{ out.lines | join('\n') }}
{%- endmacro %}

{#- flag: option without value (skip-name-resolve), enabled by a true variable. -#}
{% macro flag(var, name) -%}
{%- if var in mysql_explicit_vars and (lookup('ansible.builtin.vars', var) | bool) -%}
{{ name }}
{%- else -%}
#{{ name }}
{%- endif -%}
{%- endmacro %}
