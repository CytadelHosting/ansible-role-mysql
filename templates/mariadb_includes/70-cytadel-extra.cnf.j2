{{ ansible_managed | comment }}
{#
  Role-owned include, deployed next to the MariaDB package includes.
  It carries the settings of the monolithic my.cnf.j2 that the package include
  files do not know at all. Package options (bind-address, pid-file,
  expire_logs_days, character-set-server...) are driven in 50-server.cnf itself,
  through m.act(): one line, one place, no override in a later file.
  performance_schema and monitoring options live in 80-cytadel-monitoring.cnf.

  Only the variables set by the project (mysql_explicit_vars) are written.
  70- sorts after the package files (50-, 60-) and before the project
  overrides (90-), so a project include still has the last word.
  Each entry is (variable, option[, kind]); kinds are described in _macros.j2 (rows).
-#}
{% import 'mariadb_includes/_macros.j2' as m with context %}
{% set mysqld_options = [
  ('mysql_port', 'port'),
  ('mysql_sql_mode', 'sql_mode'),
  ('mysql_lower_case_table_names', 'lower_case_table_names'),
  ('mysql_ignore_db_dirs', 'ignore_db_dirs'),
  ('mysql_event_scheduler_state', 'event_scheduler'),
  ('mysql_disable_log_bin', 'skip-log-bin', 'flag'),
  ('mysql_log_bin_index', 'log-bin-index'),
  ('mysql_binlog_expire_logs_seconds', 'binlog_expire_logs_seconds'),
  ('mysql_binlog_format', 'binlog_format'),
  ('mysql_sort_buffer_size', 'sort_buffer_size'),
  ('mysql_read_buffer_size', 'read_buffer_size'),
  ('mysql_read_rnd_buffer_size', 'read_rnd_buffer_size'),
  ('mysql_myisam_sort_buffer_size', 'myisam_sort_buffer_size'),
  ('mysql_join_buffer_size', 'join_buffer_size'),
  ('mysql_tmp_table_size', 'tmp_table_size'),
  ('mysql_max_heap_table_size', 'max_heap_table_size'),
  ('mysql_table_definition_cache', 'table_definition_cache'),
  ('mysql_group_concat_max_len', 'group_concat_max_len'),
  ('mysql_wait_timeout', 'wait_timeout'),
  ('mysql_query_cache_type', 'query_cache_type'),
  ('mysql_query_cache_size', 'query_cache_size'),
  ('mysql_query_cache_limit', 'query_cache_limit'),
  ('mysql_innodb_file_per_table', 'innodb_file_per_table'),
  ('mysql_innodb_log_file_size', 'innodb_log_file_size'),
  ('mysql_innodb_log_buffer_size', 'innodb_log_buffer_size'),
  ('mysql_innodb_flush_log_at_trx_commit', 'innodb_flush_log_at_trx_commit'),
  ('mysql_innodb_lock_wait_timeout', 'innodb_lock_wait_timeout'),
  ('mysql_innodb_stats_on_metadata', 'innodb_stats_on_metadata'),
] %}
{% set mysqldump_options = [
  ('mysql_mysqldump_max_allowed_packet', 'max_allowed_packet'),
] %}
{% set mysqldump_lines = m.rows(mysqldump_options) %}

[mysqld]
{{ m.rows(mysqld_options) }}
{% if mysqldump_lines %}

[mysqldump]
{{ mysqldump_lines }}
{% endif %}
